# ==============================================================================
# ShadowMem — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env to customize settings for your environment.
# All settings have safe defaults and are optional.

# ---- Server & Application ----
SHADOWMEM_HOST=0.0.0.0
SHADOWMEM_PORT=8000
SHADOWMEM_RELOAD=false
SHADOWMEM_API_PREFIX=/api/v1
SHADOWMEM_CORS_ORIGINS=*

# ---- Forensics & Detection Engine ----
SHADOWMEM_MODEL_PATH=shadowmem_model.pkl
SHADOWMEM_THRESHOLD_MALICIOUS=70.0
SHADOWMEM_THRESHOLD_SUSPICIOUS=35.0
SHADOWMEM_JIT_SCORE_CAP=25.0

# Comma-separated list of additional JIT engine executable names to allowlist
# SHADOWMEM_JIT_ENGINE_ALLOWLIST=chrome.exe,msedge.exe,firefox.exe,code.exe

# ---- Alert Ticker & Streaming ----
SHADOWMEM_SCAN_INTERVAL_SECONDS=30.0

# ---- Logging ----
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
SHADOWMEM_LOG_LEVEL=INFO

# ---- Future Integration Points (Planned Extensions) ----
SHADOWMEM_DOCKER_SANDBOX_ENABLED=false
SHADOWMEM_DOCKER_WSL_DISTRO=Ubuntu
SHADOWMEM_SUPPLY_CHAIN_SCANNER_ENABLED=false
