# ==============================================================================
# ShadowMem Frontend — Environment Configuration
# ==============================================================================
# Set this to the public URL of your deployed ShadowMem backend
# Example: https://shadowmem-backend.onrender.com (or https://your-railway-app.up.railway.app)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional: Dedicated WebSocket URL if different from NEXT_PUBLIC_API_URL
# Example: wss://shadowmem-backend.onrender.com
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
